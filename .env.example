# Copy this file to backend/.env for local development. Do not commit backend/.env.
# Existing OS/CI environment variables take precedence over values in .env.

GEO_APP_ENV=development
GEO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Primary persistent database connection. Copy to .env and replace change-me.
# A supplied postgresql:// URL is also accepted and normalized to psycopg v3.
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5434/GEO_DEV_DB

# Optional legacy alias. SQLALCHEMY_DATABASE_URL takes precedence when both exist.
# Leave both database variables unset to use backend/data/geo_study.sqlite3.
# GEO_DATABASE_URL=sqlite:///./data/real_product_example.sqlite3

# Local source used by the Amazon catalog importer. It is intentionally a
# relative path so each researcher can keep the dataset outside version control.
GEO_AMAZON_CATALOG_CSV=../E-Commerce_Dataset/Amazon-Products.csv
GEO_CATALOG_IMPORT_BATCH_SIZE=1000

# Optional: seed this CSV only when the configured database is empty.
# The bundled example contains verified manufacturer facts, but is illustrative
# only and must not be used as a published result.
# GEO_SEED_CATALOG_CSV=../examples/real_world_commuter_bottles/commuter_bottles_catalog.csv

# There are no API keys in this project template. The benchmark runner evaluates
# imported, versioned outputs and never calls an external engine by itself.

# Optional OpenAI configuration for the grounded shopping agent
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Backend API server port
PORT=8001
